# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=phlab
POSTGRES_PASSWORD=phlab
POSTGRES_DB=prosthetic_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://phlab:phlab@localhost:5432/prosthetic_lab
DATABASE_URL_SYNC=postgresql+psycopg://phlab:phlab@localhost:5432/prosthetic_lab

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
CORS_ORIGINS=["http://localhost:4200"]

# ─── LiteLLM / providers ─────────────────────────────────────────────────────
# Only set the ones you actually use. LiteLLM reads them from the environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# ─── LM Studio (primary local runtime) ───────────────────────────────────────
# Running the backend natively .......... http://localhost:1234/v1
# Running the backend in Docker ......... http://host.docker.internal:1234/v1
# docker-compose.yml already defaults to the host.docker.internal form; set
# this only if LM Studio listens on a non-default port or another machine.
LM_STUDIO_API_BASE=http://localhost:1234/v1
OLLAMA_API_BASE=http://localhost:11434

# Optional LiteLLM proxy
LITELLM_PROXY_BASE_URL=
LITELLM_MASTER_KEY=

# ─── Experiment defaults ─────────────────────────────────────────────────────
DEFAULT_LIMIT_PROFILE=TABLE_5_V3
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_RETRIES=1
