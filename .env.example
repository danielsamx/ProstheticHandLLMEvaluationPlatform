# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=phlab
POSTGRES_PASSWORD=phlab
POSTGRES_DB=prosthetic_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://phlab:phlab@localhost:5432/prosthetic_lab
DATABASE_URL_SYNC=postgresql+psycopg://phlab:phlab@localhost:5432/prosthetic_lab

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Exact origins allowed in production. In development the backend also
# accepts loopback and private-network origins on any port, so reaching
# the UI via 127.0.0.1 or a LAN address does not silently break every
# request (set CORS_ALLOW_LOCAL_ORIGINS=false to disable that).
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# ─── LiteLLM / providers ─────────────────────────────────────────────────────
# Only set the ones you actually use. LiteLLM reads them from the environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# ─── LM Studio (primary local runtime) ───────────────────────────────────────
# LEAVE THESE COMMENTED OUT unless the runtime is on another machine or port.
#
# Compose reads this file when resolving ${VAR:-default}, so a value here
# OVERRIDES the correct default in docker-compose.yml. Setting localhost was
# the cause of "LM Studio is not reachable": inside the container, localhost is
# the container. The backend now also rewrites loopback addresses to
# host.docker.internal when it detects it is containerised, so the sane path is
# simply to leave this unset.
#
#   backend running natively ....... http://localhost:1234/v1
#   backend running in Docker ...... http://host.docker.internal:1234/v1
#
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# OLLAMA_API_BASE=http://localhost:11434
LITELLM_PROXY_BASE_URL=
LITELLM_MASTER_KEY=

# ─── Experiment defaults ─────────────────────────────────────────────────────
DEFAULT_LIMIT_PROFILE=TABLE_5_V3
# Local CPU inference is slow in a way hosted APIs are not, and prompt
# processing dominates: a small model can spend minutes before its first token.
# This is a ceiling to stop a wedged request holding a connection forever, not
# an expectation of how long inference takes.
#
# It was 120, which is a hosted-API figure. Because Compose reads this file for
# ${VAR} interpolation *and* passes it into the container, the value here beats
# the application default in both directions — so the 1800 in config.py never
# applied and every slow run died at two minutes.
LLM_REQUEST_TIMEOUT_S=1800
LLM_MAX_RETRIES=1
